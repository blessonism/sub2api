# Langfuse 观测层部署参数（独立机器专用，业务服务器不参与）。
# 复制为 .env 并填入随机值：openssl rand -hex 32 / openssl rand -base64 24
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
INIT_USER_PASSWORD=
# project 级密钥，供业务侧 observability.langfuse.public_key / secret_key 使用
LF_PUBLIC_KEY=pk-lf-
LF_SECRET_KEY=sk-lf-

# 对外访问地址（NextAuth 回调与 cookie 依赖它，必须与浏览器地址逐字一致）
LANGFUSE_PUBLIC_URL=https://infuse.dshvip.site
# web 监听地址：只绑 docker 网关，供同宿主反向代理访问，不对公网监听
LANGFUSE_BIND_IP=172.19.0.1

# v4 写模式：dual 同时写 legacy 表与 events_full，保持 /api/public/ingestion 可用。
# 不设置或设为 events_only 会让 legacy ingestion 直接停用，只收 OTel。
#
# 业务侧现在还走 legacy /api/public/ingestion，所以这一项**必须保持 dual**。
# 改成 events_only 的前提是先把上报通道切到 /api/public/otel/v1/traces
# （带 x-langfuse-ingestion-version: 4，否则最多延迟 10 分钟），两件事必须同批上线。
V4_WRITE_MODE=dual

# 外部 S3（S3 兼容对象存储）。观测层不落本地盘：事件与媒体都进这个桶。
S3_ENDPOINT=https://s3.bitiful.net
S3_REGION=cn-east-1
S3_BUCKET=sub2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
